# =============================================================================
# todo-api-fastapi — 환경 변수
#
# `TODO_MODE` 하나로 모드 프리셋이 결정된다. 그래서 실제 env 파일에는
# **모드 선언 + 비밀값만** 남는다 (prod-local 기준 ~10줄).
#
#   TODO_MODE = {코드 신선도} - {위치}
#               dev  = 작업 중 신버전·핫리로드      local = sync 클라이언트
#               prod = 검증된 고정 이미지            prod  = sync 서버
#
#   → dev-local | dev-prod | prod-local | prod-prod   (미설정 = 레거시)
#
#   우선순위: 명시 env  >  모드 프리셋  >  레거시 기본값
#
# - `TODO_MODE` 를 설정하면 **빈 문자열 = 미지정**으로 본다 → 프리셋이 채운다.
#   프리셋을 이기려면 비어 있지 않은 값을 주면 된다.
# - `TODO_MODE` 를 **생략하면 레거시 모드**다 — 아래 "레거시 전체 목록"처럼 모든 값을
#   직접 적어야 하고, 동작은 예전과 100% 동일하다.
# - dev 는 **항상 페어**다 (dev-local ↔ dev-prod). sync 가 1급 기능이라 개발 환경
#   자체가 클라↔서버 실토폴로지의 축소판이다. "sync 꺼진 dev" 모드는 없다.
# - 프리셋 표와 기동 검증(preflight) 규칙은 `CLAUDE.md` 의 TODO_MODE 섹션 참조.
#
# 파일 관례 (전부 untracked):
#   .env        레거시/호스트 실행용 (기존 파일 — 그대로 동작한다)
#   .env.dev    dev 페어 비밀 — dev-local·dev-prod 가 **공유**한다
#   .env.local  prod-local 비밀 (기존 `.env.sync-client` 를 흡수하고 **폐기**한다)
#   NAS `.env`  prod-prod 비밀
# =============================================================================


# -----------------------------------------------------------------------------
# 1) dev 페어 — `.env.dev` 하나를 두 모드가 공유한다.
#    dev-local: api :20023 / web :30333, DB teddynote_dev_local, sync client
#    dev-prod : api :20024 / web :30334, DB teddynote_dev_prod,  sync server
#    둘 다 로컬 auth(:3032). sync credential 도 로컬 auth 에서 1회 온보딩한다.
# -----------------------------------------------------------------------------
# TODO_MODE=dev-local              # 또는 dev-prod (compose 가 서비스별로 주입)
# DB_PASSWORD=
# TODO_OIDC_CLIENT_SECRET=         # 로컬 auth 의 todo 클라이언트 secret
# SYNC_ACCOUNT_ID=                 # 로컬 auth 계정 id (페어 공용)
# SYNC_KEY_ID=                     # dev-local 이 제시할 sync credential (scope `sync`)
# SYNC_SECRET=
# AUTH_SERVICE_KEY_ID=             # dev-prod 가 피어 credential 을 검증할 때 쓴다
# AUTH_SERVICE_SECRET=
# SYNC_ALLOWED_KEY_IDS=            # dev-prod 가 수락할 peer keyId (= 위 SYNC_KEY_ID)
# LIVEKIT_API_KEY=                 # 선택 — 화면공유를 테스트할 때만
# LIVEKIT_API_SECRET=


# -----------------------------------------------------------------------------
# 2) prod-local — 노트북 실사용 (api :20022 / web :3030, DB teddynote)
#    prod auth 를 쓰고 sync **클라이언트**로 https://todo.lafamila.xyz 와 동기화한다.
#    prod 전용 표면(화면공유·게시·멤버초대)을 숨기는 **유일한** 모드다.
# -----------------------------------------------------------------------------
# TODO_MODE=prod-local
# DB_PASSWORD=
# TODO_OIDC_CLIENT_SECRET=         # prod auth 의 todo 클라이언트 secret
# AUTH_SERVICE_KEY_ID=             # 이 노드 자신의 auth service credential
# AUTH_SERVICE_SECRET=
# SYNC_KEY_ID=                     # 노트북 전용 sync credential (scope `sync`)
# SYNC_SECRET=
# SYNC_ACCOUNT_ID=                 # 동기화 대상 auth 계정 id
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=


# -----------------------------------------------------------------------------
# 3) prod-prod — NAS 배포판. 진실의 원천이자 sync **서버**.
#    DB teddy-mysql:3306 / 내부 auth http://auth-api-nest:3032
# -----------------------------------------------------------------------------
# TODO_MODE=prod-prod
# DB_PASSWORD=
# TODO_OIDC_CLIENT_SECRET=
# AUTH_SERVICE_KEY_ID=             # 자기 인증용 (피어 credential 검증에 필요)
# AUTH_SERVICE_SECRET=
# SYNC_ALLOWED_KEY_IDS=            # 수락할 피어 keyId (쉼표 구분) — server 역할 필수
# SYNC_ACCOUNT_ID=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
#
# ⚠️ DB_NAME 은 프리셋이 `teddynote` 로 가정한다. NAS 실제 DB 이름이 다르면
#    `DB_NAME=` 을 **명시**해야 한다 (init_db 가 없는 DB 를 새로 만들기 때문에
#    조용히 빈 DB 로 기동될 수 있다).


# =============================================================================
# 프리셋이 결정하는 값 (모드를 쓰면 적을 필요가 없다)
#
#  키                            dev-local                        dev-prod                         prod-local                       prod-prod
#  ---------------------------- -------------------------------- -------------------------------- -------------------------------- --------------------------------
#  DB_HOST                      host.docker.internal             host.docker.internal             host.docker.internal             teddy-mysql
#  DB_PORT                      33306                            33306                            33306                            3306
#  DB_NAME                      teddynote_dev_local              teddynote_dev_prod               teddynote                        teddynote
#  DB_USER                      root                             root                             root                             root
#  AUTH_ISSUER_URL              http://localhost:3032            http://localhost:3032            https://auth.lafamila.xyz        https://auth.lafamila.xyz
#  AUTH_PUBLIC_BASE_URL         http://localhost:3032            http://localhost:3032            https://auth.lafamila.xyz        https://auth.lafamila.xyz
#  AUTH_API_BASE_URL            http://host.docker.internal:3032 http://host.docker.internal:3032 https://auth.lafamila.xyz        http://auth-api-nest:3032
#  AUTH_JWKS_URL                (위 + /oauth/jwks)                (위 + /oauth/jwks)                (위 + /oauth/jwks)                (위 + /oauth/jwks)
#  AUTH_AUDIENCE                service:todo                     service:todo                     service:todo                     service:todo
#  TODO_ALLOWED_ORIGINS         localhost:30333,127.0.0.1:30333  localhost:30334,127.0.0.1:30334  localhost:3030,127.0.0.1:3030    https://todo.lafamila.xyz
#  TODO_OIDC_CLIENT_ID          todo-web                         todo-web                         todo-web                         todo-web
#  TODO_OIDC_REDIRECT_URI       http://localhost:20023           http://localhost:20024           http://localhost:20022           https://todo.lafamila.xyz
#                                 /api/todo/session/callback       /api/todo/session/callback       /api/todo/session/callback       /api/todo/session/callback
#  TODO_WEB_BASE_URL            http://localhost:30333           http://localhost:30334           http://localhost:3030            https://todo.lafamila.xyz
#  TODO_SESSION_COOKIE_NAME     teddy_todo_dev_local_session     teddy_todo_dev_prod_session      teddy_todo_session               teddy_todo_session
#  TODO_SESSION_COOKIE_SECURE   false                            false                            false                            true
#  TODO_SESSION_COOKIE_SAMESITE lax                              lax                              lax                              lax
#  TODO_SESSION_COOKIE_DOMAIN   (비움)                            (비움)                            (비움)                            (비움)
#  TODO_SESSION_MAX_AGE_SECONDS 604800                           604800                           604800                           604800
#  TODO_LOCAL_SESSION_ENABLED   true                             false                            true                             false
#  TODO_SESSION_DB_PERSISTENCE  false                            false                            true                             false
#  LIVEKIT_URL                  ws://host.docker.internal:7880   ws://host.docker.internal:7880   ws://host.docker.internal:7880   ws://teddy-livekit:7880
#  SYNC_ENABLED                 true                             true                             true                             true
#  SYNC_PEER_URL                http://todo-api-dev-prod:8000    (비움)                            https://todo.lafamila.xyz        (비움)
#  SYNC_CLIENT_ID               laptop                           (비움 → laptop)                   laptop                           (비움 → laptop)
#  SYNC_DAEMON_AUTOSTART        true                             false                            true                             false
#  → sync 역할                   client                           server                           client                           server
#  → prod 전용 표면 숨김           아니오                            아니오                            **예**                            아니오
#
# 쿠키 이름이 모드마다 다른 이유: localhost 는 **포트가 달라도 쿠키를 공유**한다.
# 같은 이름을 쓰면 dev 페어의 두 web 이 서로의 로그인을 덮어쓴다.
#
# 모드와 무관하게 동일한 튜닝값: SYNC_POLL_SECONDS=60, SYNC_PUSH_DEBOUNCE_MS=1000,
# SYNC_OFFLINE_BACKOFF_SECONDS=30, SYNC_CLOCK_SKEW_LIMIT_SECONDS=5,
# SYNC_VERIFY_CACHE_SECONDS=300, SYNC_BATCH_LIMIT=500, SYNC_ALLOW_SCHEMA_DRIFT=false,
# SYNC_LOCK_TTL_SECONDS=120, SYNC_HTTP_TIMEOUT_SECONDS=15, SYNC_REQUIRED_SCOPE=sync,
# SYNC_BACKUP_DIR=../.backups/db, AUTH_JWKS_CACHE_SECONDS=300.
# AUTH_VERIFY_URL 은 비우면 `{AUTH_API_BASE_URL}/api/internal/service-credentials/verify`.
#
# 확정된 값은 `python -m src.config` 로 언제든 덤프할 수 있다 (비밀은 존재 여부만 표시).
# =============================================================================


# =============================================================================
# 레거시 전체 목록 — `TODO_MODE` 를 쓰지 않을 때의 형태 (기존 `.env` 가 이 모양이다).
# 호스트에서 직접 uvicorn 을 띄울 때의 기본값이기도 하다.
# =============================================================================

DB_HOST=localhost
DB_PORT=33306
DB_USER=root
DB_PASSWORD=
DB_NAME=teddynote

AUTH_ISSUER_URL=http://localhost:3032
# Browser-facing authorize URL; may differ from the container server-to-server URL.
AUTH_PUBLIC_BASE_URL=http://localhost:3032
AUTH_API_BASE_URL=http://localhost:3032
AUTH_JWKS_URL=http://localhost:3032/oauth/jwks
AUTH_AUDIENCE=service:todo
AUTH_JWKS_CACHE_SECONDS=300

TODO_ALLOWED_ORIGINS=http://localhost:3034,http://127.0.0.1:3034
TODO_OIDC_CLIENT_ID=todo-web
TODO_OIDC_CLIENT_SECRET=
TODO_OIDC_REDIRECT_URI=http://localhost:8000/api/todo/session/callback
TODO_WEB_BASE_URL=http://localhost:3034
TODO_SESSION_COOKIE_NAME=teddy_todo_session
TODO_SESSION_COOKIE_SECURE=false
TODO_SESSION_COOKIE_SAMESITE=lax
TODO_SESSION_COOKIE_DOMAIN=
TODO_SESSION_MAX_AGE_SECONDS=604800

AUTH_SERVICE_KEY_ID=
AUTH_SERVICE_SECRET=

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------------------
# Offline sync (root plan: TODO OFFLINE SYNC)
#
# One codebase, role decided by config:
#   SYNC_ENABLED=false                    -> disabled (legacy dev stack only)
#   SYNC_ENABLED=true  + SYNC_PEER_URL    -> client   (*-local: runs the sync daemon)
#   SYNC_ENABLED=true  + no SYNC_PEER_URL -> server   (*-prod: serves /api/sync/* to peers)
#
# With TODO_MODE set, the mode decides this triple — you do not set it by hand.
# ---------------------------------------------------------------------------

# Master switch. Leave false on a legacy development stack.
SYNC_ENABLED=false
# Client role only: base URL of the peer todo API (source of truth for this node).
SYNC_PEER_URL=
# Client identity recorded in push requests / sync_state.peer.
SYNC_CLIENT_ID=laptop
# Client role only: auth-issued service credential with scope `sync` (same serviceKey `todo`, own keyId).
SYNC_KEY_ID=
SYNC_SECRET=
# Server role only: comma-separated peer keyIds accepted after auth verification.
# Required in server role. Do not copy SYNC_KEY_ID implicitly; list each authorized peer explicitly.
SYNC_ALLOWED_KEY_IDS=
# Polling safety net (seconds) — catches DB-level changes that emit no socket event.
SYNC_POLL_SECONDS=60
# Local-write debounce before pushing (milliseconds).
SYNC_PUSH_DEBOUNCE_MS=1000
# Retry interval while the peer is unreachable (seconds).
SYNC_OFFLINE_BACKOFF_SECONDS=30
# Abort sync when |local clock - peer serverTimeUtc| exceeds this (seconds).
SYNC_CLOCK_SKEW_LIMIT_SECONDS=5
# Server role: how long an auth credential verdict is cached (seconds).
SYNC_VERIFY_CACHE_SECONDS=300
# Rows per push/pull batch.
SYNC_BATCH_LIMIT=500
# Client role: sync only the columns both sides declare when schema versions differ.
SYNC_ALLOW_SCHEMA_DRIFT=false
# Client role: run the sync daemon inside the API process (needed for local socket re-broadcast).
SYNC_DAEMON_AUTOSTART=true
# Server role: memo edit-lock lease length for delegated locks (seconds).
SYNC_LOCK_TTL_SECONDS=120
# Peer HTTP request timeout (seconds).
SYNC_HTTP_TIMEOUT_SECONDS=15
# Server role: auth service-credential verify endpoint. Empty -> {AUTH_API_BASE_URL}/api/internal/service-credentials/verify
AUTH_VERIFY_URL=
# Scope the presented sync credential must carry.
SYNC_REQUIRED_SCOPE=sync
# Account whose data the sync credential may touch. Empty -> auto-resolved when the DB
# has exactly one distinct owner id; required while the DB is still empty (bootstrap).
SYNC_ACCOUNT_ID=
# Where `python -m src.sync_cli bootstrap` writes mysqldump backups.
SYNC_BACKUP_DIR=../.backups/db

# Offline login: issue an indefinite local session from the cached identity when the
# remote auth server is unreachable. Assumes the API is bound to 127.0.0.1 (client nodes).
TODO_LOCAL_SESSION_ENABLED=false
# Persist sessions to the local DB so they survive process restarts (reload/reboot) —
# the last piece of "log in once, stay signed in indefinitely". prod-local only.
TODO_SESSION_DB_PERSISTENCE=false
